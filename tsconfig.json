{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "extensions/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "eval/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["pi-runtime", "node_modules"]
}
