{
  "name": "triple-pi",
  "version": "1.0.0-rc.1",
  "description": "Coding Agent cross-session memory and code review system — built on Pi Agent Runtime",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "install-ext": "node scripts/install-extension.mjs",
    "cron:remove": "node scripts/remove-cron.mjs",
    "memory:status": "node --experimental-strip-types scripts/memory-status.mjs",
    "memory:reset": "node scripts/memory-reset.mjs",
    "memory:reset:dry-run": "node scripts/memory-reset.mjs --dry-run",
    "build:pi": "npm --prefix pi-runtime install --ignore-scripts && npm --prefix pi-runtime run build",
    "setup": "npm run build:pi && npm install && npm run install-ext && npm run memory:status",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "node --experimental-strip-types scripts/demo.mjs",
    "eval": "npm run eval:recorded",
    "eval:recorded": "vitest run test/eval",
    "eval:live": "node --experimental-strip-types eval/live-runner.ts",
    "eval:reviewer-pilot": "node --experimental-strip-types eval/reviewer-pilot.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "file:./pi-runtime/packages/agent",
    "@earendil-works/pi-ai": "file:./pi-runtime/packages/ai",
    "@earendil-works/pi-coding-agent": "file:./pi-runtime/packages/coding-agent",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
